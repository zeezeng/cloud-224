# ======================== Docker Compose 环境变量配置 ========================
# 复制本文件为 .env 并按需修改后使用：cp .env.example .env

# ---------------- 后端应用 ----------------
# 对外暴露端口
APP_PORT=8080
APP_IMAGE=cloud-224
APP_IMAGE_TAG=local
JAVA_OPTS=-Xms512m -Xmx512m -Dfile.encoding=UTF-8
MARS_DEMO_MODE=false
APP_LOG_LEVEL=info
NODE_REGISTRY_URL=https://registry.npmmirror.com
MAVEN_MIRROR_ID=custom-maven-mirror
MAVEN_MIRROR_URL=https://repo.maven.apache.org/maven2

# ---------------- MySQL 数据库 ----------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mars-system
MYSQL_PORT=3306

# ---------------- Redis 缓存 ----------------
# 留空表示无密码
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DATABASE=10
