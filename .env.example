# ======================== Docker Compose 环境变量配置 ========================
# 复制本文件为 .env 并按需修改后使用：cp .env.example .env

# ---------------- 后端应用 ----------------
# 对外暴露端口
APP_PORT=8080
APP_IMAGE=ghcr.io/your-github-username/cloud-224
APP_IMAGE_TAG=latest
JAVA_OPTS=-Xms512m -Xmx512m -Dfile.encoding=UTF-8
MARS_DEMO_MODE=false
APP_LOG_LEVEL=info
GHCR_USERNAME=your-github-username
GHCR_TOKEN=your-ghcr-token

# ---------------- MySQL 数据库 ----------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mars-system
MYSQL_PORT=3306

# ---------------- Redis 缓存 ----------------
# 留空表示无密码
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DATABASE=10
