/* uni-app 内置变量覆盖 */
.page.data-v-6fcd4848 {
  min-height: 100vh;
  background: #F0F0F0;
}

/* 提示条 */
.tip-bar.data-v-6fcd4848 {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: rgba(24, 144, 255, 0.06);
  margin: 0 0 20rpx;
}
.tip-text.data-v-6fcd4848 {
  font-size: 24rpx;
  color: #1890FF;
  margin-left: 10rpx;
}

/* 表单区域 */
.form-section.data-v-6fcd4848 {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
.form-item.data-v-6fcd4848 {
  padding: 0 28rpx;
  position: relative;
}
.form-item + .form-item.data-v-6fcd4848::before {
  content: "";
  position: absolute;
  top: 0;
  left: 28rpx;
  right: 28rpx;
  height: 1rpx;
  background: #F2F2F2;
}
.form-label.data-v-6fcd4848 {
  display: block;
  font-size: 24rpx;
  color: #999999;
  padding-top: 24rpx;
}
.input-wrap.data-v-6fcd4848 {
  display: flex;
  align-items: center;
  padding: 12rpx 0 24rpx;
}
.form-input.data-v-6fcd4848 {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A1A;
  height: 56rpx;
}
.placeholder.data-v-6fcd4848 {
  color: #CCCCCC;
  font-size: 28rpx;
}
.eye-btn.data-v-6fcd4848 {
  padding: 12rpx;
  flex-shrink: 0;
}

/* 密码强度 */
.strength-section.data-v-6fcd4848 {
  display: flex;
  align-items: center;
  padding: 24rpx 52rpx;
}
.strength-label.data-v-6fcd4848 {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}
.strength-bars.data-v-6fcd4848 {
  display: flex;
  gap: 8rpx;
  margin: 0 12rpx;
}
.strength-bar.data-v-6fcd4848 {
  width: 60rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E8E8E8;
  transition: background 0.3s;
}
.strength-bar.active.weak.data-v-6fcd4848 {
  background: #FF4D4F;
}
.strength-bar.active.medium.data-v-6fcd4848 {
  background: #FAAD14;
}
.strength-bar.active.strong.data-v-6fcd4848 {
  background: #52C41A;
}
.strength-text.data-v-6fcd4848 {
  font-size: 24rpx;
}
.text-weak.data-v-6fcd4848 {
  color: #FF4D4F;
}
.text-medium.data-v-6fcd4848 {
  color: #FAAD14;
}
.text-strong.data-v-6fcd4848 {
  color: #52C41A;
}

/* 提交按钮 */
.btn-wrap.data-v-6fcd4848 {
  padding: 60rpx 24rpx;
}
.submit-btn.data-v-6fcd4848 {
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #07C160 0%, #059B4B 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}
.submit-btn[disabled].data-v-6fcd4848 {
  opacity: 0.6;
}
.submit-btn.data-v-6fcd4848::after {
  border: none;
}