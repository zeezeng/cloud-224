/* uni-app 内置变量覆盖 */
.page.data-v-201c0da5 {
  min-height: 100vh;
  background: #F0F0F0;
}

/* ---- 顶部区域 ---- */
.header-wrap.data-v-201c0da5 {
  background: linear-gradient(160deg, #059B4B 0%, #07C160 45%, #2BD373 100%);
  padding-bottom: 48rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 */
.header-wrap.data-v-201c0da5::before {
  content: "";
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  top: -160rpx;
  right: -80rpx;
}
.header-wrap.data-v-201c0da5::after {
  content: "";
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  bottom: -40rpx;
  left: -60rpx;
}
.status-bar.data-v-201c0da5 {
  width: 100%;
}
.nav-bar.data-v-201c0da5 {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}
.nav-title.data-v-201c0da5 {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* ---- 用户居中区域 ---- */
.user-center.data-v-201c0da5 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 8rpx;
  position: relative;
  z-index: 2;
}
.avatar-wrap.data-v-201c0da5 {
  position: relative;
  margin-bottom: 18rpx;
}
.user-avatar.data-v-201c0da5 {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  background: #E0E0E0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}
.avatar-camera.data-v-201c0da5 {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}
.user-nickname.data-v-201c0da5 {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.user-id.data-v-201c0da5 {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 6rpx;
}

/* ---- 菜单区域 ---- */
.menu-scroll.data-v-201c0da5 {
  flex: 1;
}
.menu-group.data-v-201c0da5 {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
.menu-item.data-v-201c0da5 {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  position: relative;
  /* 分割线 - 除最后一个 */
}
.menu-item.data-v-201c0da5:active {
  background: #F7F7F7;
}
.menu-item + .menu-item.data-v-201c0da5::before {
  content: "";
  position: absolute;
  top: 0;
  left: 80rpx;
  right: 28rpx;
  height: 1rpx;
  background: #F2F2F2;
}
.menu-icon-wrap.data-v-201c0da5 {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-text.data-v-201c0da5 {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 400;
}
.menu-value.data-v-201c0da5 {
  font-size: 24rpx;
  color: #BBBBBB;
  margin-right: 8rpx;
}

/* ---- 退出按钮 ---- */
.logout-wrap.data-v-201c0da5 {
  padding: 40rpx 24rpx 80rpx;
}
.logout-btn.data-v-201c0da5 {
  height: 88rpx;
  line-height: 88rpx;
  background: #FFFFFF;
  color: #FA5151;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
.logout-btn.data-v-201c0da5::after {
  border: none;
}