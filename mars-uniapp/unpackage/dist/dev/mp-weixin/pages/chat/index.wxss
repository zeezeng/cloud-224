  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
}
.msg-input.data-v-5a559478 {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.5;
  color: #333;
  width: 100%;
  min-height: 44rpx;
  max-height: 210rpx;
}
.input-placeholder.data-v-5a559478 {
  color: #BCBCBC;
}

/* 发送按钮 */
.send-btn-new.data-v-5a559478 {
  height: 64rpx;
  padding: 0 28rpx;
  margin: 4rpx 4rpx;
  background: #07C160;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.send-btn-new text.data-v-5a559478 {
  font-size: 28rpx;
  color: #FFF;
  font-weight: 600;
}
.send-btn-new.data-v-5a559478:active {
