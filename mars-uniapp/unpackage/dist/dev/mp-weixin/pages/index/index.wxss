.page.data-v-1cf27b2a {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #EDEDED;
}
.search-bar.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #07C160;
  gap: 12rpx;
}
.search-input.data-v-1cf27b2a {
  flex: 1;
  display: flex;
  align-items: center;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 6rpx;
  padding: 0 16rpx;
}
.search-placeholder.data-v-1cf27b2a {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-left: 8rpx;
}
.add-btn.data-v-1cf27b2a {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-menu.data-v-1cf27b2a {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}
.menu-content.data-v-1cf27b2a {
  position: absolute;
  top: calc(var(--status-bar-height) + 90rpx);
  right: 20rpx;
  background: #4C4C4C;
  border-radius: 6rpx;
  padding: 4rpx 0;
  min-width: 260rpx;
}
.menu-item.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
}
.menu-item text.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #FFF;
}
.menu-icon-text.data-v-1cf27b2a {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  background: #07C160;
  font-size: 20rpx;
  color: #FFF;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}
.conversation-list.data-v-1cf27b2a {
  flex: 1;
  overflow: hidden;
}
.conversation-item.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #FFF;
  border-bottom: 1rpx solid #F0F0F0;
}
.conversation-item.data-v-1cf27b2a:active {
  background: #ECECEC;
}
.avatar-wrap.data-v-1cf27b2a {
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.conv-avatar.data-v-1cf27b2a {
  width: 84rpx;
  height: 84rpx;
  border-radius: 8rpx;
  background: #E0E0E0;
}
.avatar-text.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-text text.data-v-1cf27b2a {
  font-size: 36rpx;
  color: #FFF;
  font-weight: 600;
}
.avatar-badge.data-v-1cf27b2a {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  z-index: 2;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 32rpx;
  background: #FA5151;
  border: 3rpx solid #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-badge text.data-v-1cf27b2a {
  font-size: 18rpx;
  color: #FFF;
  font-weight: 600;
  line-height: 1;
}
.conv-info.data-v-1cf27b2a {
  flex: 1;
  min-width: 0;
}
.conv-top.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
