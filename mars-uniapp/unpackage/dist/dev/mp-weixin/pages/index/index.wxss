  color: #B0B0B0;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.conv-bottom.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.conv-msg.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  min-width: 0;
